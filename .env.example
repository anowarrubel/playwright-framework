# Copy this file to .env and adjust values for your local runs:
#   cp .env.example .env
# .env is gitignored. In CI these come from workflow inputs and repo secrets.

# Which environment to run against: dev | qa | prod
TEST_ENV=qa

# Which site to run. Leave empty to run every site.
# Values: demoqa | academybugs | saucedemo
SITE=

# Optional credentials for sites that need login (SauceDemo's are public demo
# values; use real secrets for anything else and never commit them).
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Optional per-site, per-environment URL overrides. Pattern: <SITE>_<ENV>_URL
# Use these to point a run at a real dev/qa/prod host without editing code.
# DEMOQA_DEV_URL=https://dev.example.com
# SAUCEDEMO_QA_URL=https://qa.example.com
